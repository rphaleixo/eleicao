{
  // Segundo Worker, só para a página de cenários "e se..." no endereço ese.<conta>.workers.dev.
  // Publicação: npx wrangler deploy -c wrangler.ese.jsonc  (ou um segundo projeto no Workers Builds com este arquivo).
  // Sem KV, banco nem rotina agendada: a página só lê os resultados do TSE pelo proxy do próprio Worker.
  "name": "ese",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/_seed/*"]
  }
}
