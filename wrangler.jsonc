{
  "name": "eleicao",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "HIST", "id": "cc2ee1f18cc844a1ac57ae8ed456c371" }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
